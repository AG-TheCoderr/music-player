# Copy to `.env` (never commit the real file) for local Supabase function development.

# Required by the youtube-search function.
# https://developers.google.com/youtube/registering_an_application
YT_API_KEY=

# Optional. When set, the audio-stream-proxy will only forward requests to these hosts
# (comma separated, subdomains are allowed).
# ALLOWED_PROXY_HOSTS=cdn.example.com,audio.example.org
